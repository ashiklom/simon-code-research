     }
     attributes = {
         key: value.tolist() if isinstance(value, np.generic) else value
         for key, value in variable.items()
         if key not in _DECODER_KEYS
     }
+    if "_FillValue" in attributes:  # BLUNT FIX: CF-encode like the other parsers
+        enc = encode_cf_fill_value(np.asarray(attributes["_FillValue"]), np.dtype(zarray["dtype"]))
+        if enc is None:
+            attributes.pop("_FillValue")
+        else:
+            attributes["_FillValue"] = enc
+    if any(len(r) > 3 and r[3] not in ("DEFLATE", "NONE") for r in refs):
+        raise NotImplementedError(f"{name}: unsupported HDF4 compression {refs[0][3]}")
     metadata = from_kerchunk_refs(zarray, attributes)
 
     chunk_grid_shape = determine_chunk_grid_shape(metadata.shape, metadata.chunks)
