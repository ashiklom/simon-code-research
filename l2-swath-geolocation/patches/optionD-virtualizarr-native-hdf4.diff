diff --git a/virtualizarr/tests/data/make_hdf4_chunked.py b/virtualizarr/tests/data/make_hdf4_chunked.py
new file mode 100644
index 0000000..78cec78
--- /dev/null
+++ b/virtualizarr/tests/data/make_hdf4_chunked.py
@@ -0,0 +1,79 @@
+"""Generate ``hdf4_chunked.hdf4``: HDF4 chunked SDS fixtures for the native HDF4 parser tests.
+
+pyhdf does not wrap SDsetchunk, so this calls the HDF4 C library (libmfhdf) through ctypes.
+Run once; the (small) output file is committed:
+
+    python make_hdf4_chunked.py /path/to/hdf4/lib   # directory holding libdf.so and libmfhdf.so
+"""
+
+import ctypes
+import sys
+from pathlib import Path
+
+import numpy as np
+
+DFACC_CREATE = 4
+DFNT = {"u2": 23, "f8": 6, "i2": 22}
+HDF_CHUNK, HDF_COMP = 0x1, 0x3  # hproto.h
+COMP_CODE_DEFLATE = 4
+MAX_VAR_DIMS = 32
+
+
+class CompInfo(ctypes.Structure):
+    _fields_ = [("chunk_lengths", ctypes.c_int32 * MAX_VAR_DIMS), ("comp_type", ctypes.c_int32),
+                ("model_type", ctypes.c_int32), ("level", ctypes.c_int32), ("pad", ctypes.c_int32 * 16)]
+
+
+def main(lib_dir: str, out: Path) -> dict:
+    ctypes.CDLL(str(Path(lib_dir) / "libdf.so"), mode=ctypes.RTLD_GLOBAL)
+    lib = ctypes.CDLL(str(Path(lib_dir) / "libmfhdf.so"))
+    for fn, res in [("SDstart", ctypes.c_int32), ("SDcreate", ctypes.c_int32)]:
+        getattr(lib, fn).restype = res
+    sd = lib.SDstart(str(out).encode(), DFACC_CREATE)
+    assert sd >= 0
+    rng = np.random.default_rng(1)
+    datasets = {
+        "chunked": (np.arange(120, dtype=">u2").reshape(10, 12), (4, 5), False),
+        "chunked_deflate": (rng.random((9, 11)).astype(">f8"), (4, 4), True),
+        # chunks of a partially written array stay unwritten -> fill value
+        "chunked_sparse": (np.arange(64, dtype=">i2").reshape(8, 8), (4, 4), True),
+    }
+    expected = {}
+    for name, (arr, chunk, deflate) in datasets.items():
+        dims = (ctypes.c_int32 * arr.ndim)(*arr.shape)
+        sds = lib.SDcreate(sd, name.encode(), DFNT[arr.dtype.str[1:]], arr.ndim, dims)
+        info = CompInfo()
+        for i, c in enumerate(chunk):
+            info.chunk_lengths[i] = c
+        if deflate:
+            info.comp_type, info.level = COMP_CODE_DEFLATE, 6
+        if name == "chunked_sparse":  # must precede SDsetchunk: the chunk header records it
+            fill = (ctypes.c_int16 * 1)(-9)
+            assert lib.SDsetfillvalue(sds, fill) == 0
+        assert lib.SDsetchunk(sds, info, HDF_COMP if deflate else HDF_CHUNK) == 0
+        if name == "chunked_sparse":
+            arr = arr.copy()
+            arr[4:, 4:] = -9  # only three of the four chunks are written
+            sub = np.ascontiguousarray(arr[:4, :], dtype="=i2")
+            start = (ctypes.c_int32 * 2)(0, 0)
+            edge = (ctypes.c_int32 * 2)(4, 8)
+            assert lib.SDwritedata(sds, start, None, edge, sub.ctypes.data_as(ctypes.c_void_p)) == 0
+            sub = np.ascontiguousarray(arr[4:, :4], dtype="=i2")
+            start = (ctypes.c_int32 * 2)(4, 0)
+            edge = (ctypes.c_int32 * 2)(4, 4)
+            assert lib.SDwritedata(sds, start, None, edge, sub.ctypes.data_as(ctypes.c_void_p)) == 0
+        else:
+            native = np.ascontiguousarray(arr, dtype=arr.dtype.newbyteorder("="))
+            start = (ctypes.c_int32 * arr.ndim)(*([0] * arr.ndim))
+            assert lib.SDwritedata(sds, start, None, dims, native.ctypes.data_as(ctypes.c_void_p)) == 0
+        lib.SDendaccess(sds)
+        expected[name] = arr
+    lib.SDend(sd)
+    return expected
+
+
+if __name__ == "__main__":
+    out = Path(__file__).with_name("hdf4_chunked.hdf4")
+    expected = main(sys.argv[1], out)
+    np.savez(out.with_suffix(".expected.npz"), **expected)
+    print("wrote", out, out.stat().st_size, "bytes")
