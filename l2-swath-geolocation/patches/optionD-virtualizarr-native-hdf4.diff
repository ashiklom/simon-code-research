diff --git a/virtualizarr/tests/test_parsers/test_hdf4_native.py b/virtualizarr/tests/test_parsers/test_hdf4_native.py
new file mode 100644
index 0000000..41b9059
--- /dev/null
+++ b/virtualizarr/tests/test_parsers/test_hdf4_native.py
@@ -0,0 +1,128 @@
+"""Storage layouts and metadata handled by the native HDF4 reader.
+
+Fixtures are written with pyhdf (the HDF4 C library) and read back both through the
+ManifestStore (byte references + codecs) and with pyhdf for comparison.
+"""
+
+from pathlib import Path
+
+import numpy as np
+import pytest
+import zarr
+from obspec_utils.registry import ObjectStoreRegistry
+from obstore.store import LocalStore
+
+from virtualizarr.parsers import HDF4Parser
+
+pyhdf_SD = pytest.importorskip("pyhdf.SD")
+SD, SDC = pyhdf_SD.SD, pyhdf_SD.SDC
+
+
+def _store(path: Path, **kw):
+    registry = ObjectStoreRegistry({"file://": LocalStore()})
+    return HDF4Parser(**kw)(path.as_uri(), registry)
+
+
+def _read(store, name):
+    return np.asarray(zarr.open_array(store, path=name, mode="r")[...])
+
+
+@pytest.fixture
+def layouts(tmp_path: Path) -> tuple[Path, dict]:
+    path = tmp_path / "layouts.hdf"
+    sd = SD(str(path), SDC.WRITE | SDC.CREATE | SDC.TRUNC)
+    data = {}
+
+    def add(name, typ, arr, comp=None, chunks=None, dims=None, **attrs):
+        v = sd.create(name, typ, arr.shape)
+        if chunks is not None:
+            v.setchunk(chunks, comp[0] if comp else SDC.COMP_NONE, comp[1] if comp else 0)
+        elif comp is not None:
+            v.setcompress(*comp)
+        if dims:
+            for i, d in enumerate(dims):
+                v.dim(i).setname(d)
+        v[:] = arr
+        for k, val in attrs.items():
+            setattr(v, k, val)
+        v.endaccess()
+        data[name] = arr
+
+    rng = np.random.default_rng(0)
+    add("contiguous", SDC.INT16, np.arange(35, dtype=">i2").reshape(5, 7), dims=["y", "x"])
+    add("deflate", SDC.FLOAT32, rng.random((5, 7)).astype(">f4"), comp=(SDC.COMP_DEFLATE, 6), dims=["y", "x"])
+    add("cube", SDC.INT32, np.arange(24, dtype=">i4").reshape(2, 3, 4), comp=(SDC.COMP_DEFLATE, 1))
+    add("Land/Sea", SDC.UINT8, np.arange(6, dtype="u1").reshape(2, 3))
+    add("rle", SDC.INT16, np.ones((4, 4), dtype=">i2"), comp=(SDC.COMP_RLE,))
+    sd.history = "first\x00second"  # NUL-separated strings, as in some NASA products
+    sd.scale = 0.5
+    sd.end()
+    return path, data
+
+
+@pytest.mark.parametrize("name", ["contiguous", "deflate", "cube"])
+def test_layouts_round_trip(layouts, name):
+    path, data = layouts
+    store = _store(path, skip_variables=["rle"])
+    np.testing.assert_array_equal(_read(store, name), data[name])
+    np.testing.assert_array_equal(np.asarray(SD(str(path)).select(name)[:]), data[name])
+
+
+# Chunked SDSs (pyhdf cannot write them): generated with the HDF4 C library by
+# ../data/make_hdf4_chunked.py; expected values alongside.
+CHUNKED = Path(__file__).resolve().parents[1] / "data" / "hdf4_chunked.hdf4"
+
+
+@pytest.mark.parametrize("name", ["chunked", "chunked_deflate", "chunked_sparse"])
+def test_chunked_layouts(name):
+    expected = np.load(CHUNKED.with_suffix(".expected.npz"))[name]
+    np.testing.assert_array_equal(_read(_store(CHUNKED), name), expected)
+
+
+def test_chunked_layout_is_referenced_per_chunk():
+    marr = _store(CHUNKED)._group.arrays["chunked"]
+    assert marr.metadata.chunks == (4, 5)
+    assert marr.manifest.shape_chunk_grid == (3, 3)
+    assert len(marr.manifest.dict()) == 9
+
+
+def test_unwritten_chunks_read_as_the_chunk_fill_value():
+    marr = _store(CHUNKED)._group.arrays["chunked_sparse"]
+    assert len(marr.manifest.dict()) == 3  # the 4th chunk was never written
+    assert marr.metadata.fill_value == -9
+
+
+def test_unsupported_compression_raises_and_can_be_skipped(layouts):
+    path, _ = layouts
+    with pytest.raises(NotImplementedError, match="RLE"):
+        _store(path)
+    assert "rle" not in _store(path, skip_variables=["rle"])._group.arrays
+
+
+def test_slash_in_name_and_dimension_names(layouts):
+    path, data = layouts
+    store = _store(path, skip_variables=["rle"], dimension_names="hdf4")
+    assert "Land_Sea" in store._group.arrays
+    assert store._group.arrays["Land_Sea"].metadata.attributes["hdf4_name"] == "Land/Sea"
+    np.testing.assert_array_equal(_read(store, "Land_Sea"), data["Land/Sea"])
+    assert store._group.arrays["contiguous"].metadata.dimension_names == ("y", "x")
+    generic = _store(path, skip_variables=["rle"])
+    assert generic._group.arrays["contiguous"].metadata.dimension_names == ("contiguous_x", "contiguous_y")
+
+
+def test_file_attributes(layouts):
+    path, _ = layouts
+    attrs = _store(path, skip_variables=["rle"])._group.metadata.attributes
+    assert attrs["history"] == "first\x00second"
+    assert attrs["scale"] == pytest.approx(0.5)
+
+
+def test_does_not_need_kerchunk(layouts, monkeypatch):
+    import sys
+
+    monkeypatch.setitem(sys.modules, "kerchunk", None)
+    monkeypatch.setitem(sys.modules, "kerchunk.hdf4", None)
+    path, data = layouts
+    np.testing.assert_array_equal(_read(_store(path, skip_variables=["rle"]), "deflate"), data["deflate"])
+    expected = np.load(CHUNKED.with_suffix(".expected.npz"))["chunked_deflate"]
+    np.testing.assert_array_equal(_read(_store(CHUNKED), "chunked_deflate"), expected)
diff --git a/virtualizarr/tests/test_parsers/test_nasa_regressions.py b/virtualizarr/tests/test_parsers/test_nasa_regressions.py
new file mode 100644
index 0000000..3530e2c
--- /dev/null
+++ b/virtualizarr/tests/test_parsers/test_nasa_regressions.py
@@ -0,0 +1,113 @@
+"""Regressions found on NASA MODIS (HDF4), MODIS DMR++ and VIIRS (HDF5) granules.
+
+Fixtures are generated on the fly (pyhdf / h5py), so no binary files are needed.
+"""
+
+import warnings
+from pathlib import Path
+
+import numpy as np
+import pytest
+import xarray as xr
+from obspec_utils.registry import ObjectStoreRegistry
+from obstore.store import LocalStore
+
+from virtualizarr.parsers import DMRPPParser, HDF4Parser, HDFParser
+from virtualizarr.tests import requires_kerchunk
+
+pyhdf_SD = pytest.importorskip("pyhdf.SD")
+
+
+def _open(parser, path: Path) -> xr.Dataset:
+    registry = ObjectStoreRegistry({"file://": LocalStore()})
+    store = parser(path.as_uri(), registry=registry)
+    return xr.open_zarr(store, consolidated=False, zarr_format=3, mask_and_scale=False,
+                        concat_characters=False)
+
+
+@pytest.fixture
+def modis_like_hdf4(tmp_path: Path) -> tuple[Path, dict]:
+    SD, SDC = pyhdf_SD.SD, pyhdf_SD.SDC
+    path = tmp_path / "modis_like.hdf"
+    sd = SD(str(path), SDC.WRITE | SDC.CREATE | SDC.TRUNC)
+    data = {
+        # stored contiguously and uncompressed (like MOD03 Latitude)
+        "contiguous_i2": np.arange(20, dtype=">i2").reshape(4, 5),
+        # big-endian float with a CF fill value (like MOD11_L2 Latitude)
+        "float_f4": np.linspace(-90, 90, 12, dtype=">f4").reshape(3, 4),
+        # three dimensions (like MOD03 T_inst2ECR)
+        "cube_f8": np.arange(18, dtype=">f8").reshape(2, 3, 3),
+        # character array (like MOD03 "Scan Type")
+        "chars": np.array([list(b"Day\0\0"), list(b"Night")], dtype="u1").view("S1"),
+    }
+    v = sd.create("contiguous_i2", SDC.INT16, (4, 5))
+    v[:] = data["contiguous_i2"]
+    v.endaccess()
+    v = sd.create("float_f4", SDC.FLOAT32, (3, 4))
+    v.setcompress(SDC.COMP_DEFLATE, 6)
+    v[:] = data["float_f4"]
+    v.setfillvalue(-999.0)
+    v.endaccess()
+    v = sd.create("cube_f8", SDC.FLOAT64, (2, 3, 3))
+    v.setcompress(SDC.COMP_DEFLATE, 6)
+    v[:] = data["cube_f8"]
+    v.endaccess()
+    v = sd.create("chars", SDC.CHAR8, (2, 5))
+    v[:] = data["chars"]
+    v.endaccess()
+    sd.end()
+    return path, data
+
+
+@requires_kerchunk
+def test_hdf4_contiguous_float_3d_and_char_arrays(modis_like_hdf4) -> None:
+    path, expected = modis_like_hdf4
+    ds = _open(HDF4Parser(), path)
+    for name, want in expected.items():
+        got = ds[name].values
+        assert got.shape == want.shape, name
+        np.testing.assert_array_equal(got, want, err_msg=name)
+    var = ds["float_f4"]
+    fill = var.encoding.get("_FillValue", var.attrs.get("_FillValue"))
+    assert float(fill) == pytest.approx(-999.0)  # big-endian attribute decoded correctly
+    assert ds["cube_f8"].dims == ("cube_f8_x", "cube_f8_y", "cube_f8_z")
+
+
+def test_hdf5_string_fill_value_on_integer_variable(tmp_path: Path) -> None:
+    h5py = pytest.importorskip("h5py")
+    path = tmp_path / "string_fill.h5"
+    with h5py.File(path, "w") as f:
+        d = f.create_dataset("qc", data=np.arange(6, dtype="u2").reshape(2, 3))
+        d.attrs["_FillValue"] = np.bytes_(b"n/a")  # as in VIIRS VNP21 v002
+        e = f.create_dataset("lst", data=np.arange(6, dtype="u2").reshape(2, 3))
+        e.attrs["_FillValue"] = np.bytes_(b"0")  # numeric text is parsed
+    with warnings.catch_warnings(record=True):
+        ds = _open(HDFParser(), path)
+    np.testing.assert_array_equal(ds["qc"].values, np.arange(6).reshape(2, 3))
+    assert "_FillValue" not in ds["qc"].attrs
+    assert ds["lst"].encoding.get("_FillValue", ds["lst"].attrs.get("_FillValue")) is not None
+
+
+DMRPP_BE = """<?xml version="1.0" encoding="ISO-8859-1"?>
+<Dataset xmlns="http://xml.opendap.org/ns/DAP/4.0#" xmlns:dmrpp="http://xml.opendap.org/dap/dmrpp/1.0.0#" dapVersion="4.0" dmrVersion="1.0" name="be.hdf" dmrpp:href="OPeNDAP_DMRpp_DATA_ACCESS_URL" dmrpp:version="3.21.1">
+    <Dimension name="y" size="2"/>
+    <Dimension name="x" size="3"/>
+    <UInt16 name="qc">
+        <Dim name="/y"/>
+        <Dim name="/x"/>
+        <Attribute name="_FillValue" type="String"><Value>NA</Value></Attribute>
+        <dmrpp:chunks fillValue="0" byteOrder="BE">
+            <dmrpp:chunk offset="0" nBytes="12"/>
+        </dmrpp:chunks>
+    </UInt16>
+</Dataset>
+"""
+
+
+def test_dmrpp_big_endian_and_string_fill(tmp_path: Path) -> None:
+    data = np.arange(6, dtype=">u2").reshape(2, 3)
+    (tmp_path / "be.hdf").write_bytes(data.tobytes())
+    (tmp_path / "be.hdf.dmrpp").write_text(DMRPP_BE)
+    with warnings.catch_warnings(record=True):
+        ds = _open(DMRPPParser(), tmp_path / "be.hdf.dmrpp")
+    np.testing.assert_array_equal(ds["qc"].values, data)
